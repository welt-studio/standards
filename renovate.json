{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>welt-studio/standards//renovate/default.json5"],
  "customManagers": [
    {
      "description": "O uv exato da CI, no `version` do `setup-uv` (o `required-version` do pyproject é a mínima e não sobe sozinho).",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: astral-sh/setup-uv@[^\\n]+\\n\\s+with:\\n\\s+version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    }
  ]
}
