{
  // O padrão Pyright deste repo é a cópia do próprio `pyright/base.json`, mantida pelo hook
  // `pyright-base` como nos projetos. Aqui só fatos do repo.
  "extends": "./pyright-base.json",
  "include": ["hooks", "tests"],
  "venvPath": ".",
  "venv": ".venv",
  // Os scripts se importam pelo nome (o pre-commit executa o arquivo solto), e os testes também;
  // os testes importam os ajudantes de `tests/` do mesmo jeito (o pytest põe a pasta no path).
  "executionEnvironments": [{ "root": ".", "extraPaths": ["hooks", "tests"] }]
}
