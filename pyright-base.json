// GERADO pelo hook `pyright-base` de github.com/welt-studio/standards (pyright/base.json).
// NÃO EDITE: o hook desfaz qualquer mudança. A versão do padrão é o `rev` desse hook no
// .pre-commit-config.yaml; regra nova entra no standards, para todos os projetos.

// Padrão Pyright da Welt Studio: o mesmo para todos os projetos Python.
//
// O projeto não usa este arquivo daqui: o hook `pyright-base` (este repo, `.pre-commit-hooks.yaml`)
// copia-o para `pyright-base.json` na raiz do projeto, e o `pyrightconfig.json` da raiz faz
// `extends` dessa cópia. O projeto só declara fatos dele: caminhos (`include`, `exclude`,
// `venvPath`/`venv`, `executionEnvironments` com `root`/`extraPaths`). Regra, modo e exceção vêm
// daqui, e o hook reprova o `pyrightconfig.json` que declare outra coisa.
{
  // Strict em tudo, testes incluídos. A anotação de parâmetro e de retorno é do `ANN` do Ruff, que a
  // cobra no código e a libera nos testes (ver `reportMissingParameterType` abaixo). O projeto não
  // declara `strict` nem põe `# pyright: strict` num arquivo: no Pyright os dois religam toda regra
  // do strict que esta base desliga (o hook reprova os dois).
  "typeCheckingMode": "strict",
  // Sem a família reportUnknown* (decisão do PO, 2026-11-05): boa parte das bibliotecas do
  // ecossistema Python não tipa direito, e o `Unknown` que vem delas reprovava cada linha que as
  // tocava, numa fila que não fecha. O Pyright não separa o `Unknown` da biblioteca do nosso: o
  // `items = []` que recebe qualquer coisa também passa calado (aceito pelo PO). O contrato
  // declarado continua cobrado: genérico sem argumento (`reportMissingTypeArgument`) e, fora dos
  // testes, parâmetro e retorno sem anotação (`ANN` do Ruff).
  "reportUnknownMemberType": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  "reportUnknownParameterType": "none",
  "reportUnknownLambdaType": "none",
  // Acesso a privado é do Ruff (`SLF001`), que o cobra no código e o libera nos testes, onde
  // conferir um `_helper` é o normal. Com o strict nos testes, as duas ferramentas discordariam.
  "reportPrivateUsage": "none",
  // Parâmetro sem anotação é do Ruff (`ANN001`-`ANN003`), que o cobra no código e o libera nos
  // testes (decisão do PO, 2026-11-05): fixture do pytest é injetada pelo nome, e o teste roda
  // inteiro a cada suíte, então um tipo errado ali já falha no pytest. Com a regra no Pyright, cada
  // `def test_x(client, db)` reprovava (milhares por projeto) e as duas ferramentas discordavam.
  "reportMissingParameterType": "none",
  // Ignorar erro de tipo é contorno (decisão do PO, 2026-11-05): o `# type: ignore` não vale (o erro
  // continua aparecendo), e o hook `pyright-base` reprova o comentário e todo `# pyright: ignore`
  // fora o marcador de lib sem stubs publicados (`# pyright: ignore[reportMissingTypeStubs]` no
  // import). Esse marcador sai sozinho: com um pacote de stubs instalado, ele não ignora nada e
  // reprova aqui.
  "enableTypeIgnoreComments": false,
  "reportUnnecessaryTypeIgnoreComment": "error",
  // Saída de gerador (migrations do Alembic/Django) e código de terceiros (transcrito ou copiado em
  // `vendor/`, ou minificado) seguem o gerador ou o original: o Pyright não acusa nada dentro deles,
  // como o Ruff, o Prettier e o jscpd do padrão. Quem os usa continua conferido contra os tipos
  // deles. É a lista comum do padrão (`eslint/ignores.json` no standards), igual em todas as
  // ferramentas, e um teste do standards reprova se esta divergir; os padrões de JS/CSS não casam
  // com nada aqui. O projeto não declara `ignore`: declarar substituiria este.
  "ignore": [
    "**/*.gen.ts",
    "**/migrations/**",
    "**/alembic/versions/**",
    "**/vendor/**",
    "**/*.min.js",
    "**/*.min.mjs",
    "**/*.min.cjs",
    "**/*.min.css"
  ]
}
